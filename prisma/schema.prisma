generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  MONITOR
  STUDENT
}

enum TripStatus {
  // Created, and the coordinator hasn't started the trip yet (first "En ruta" / "En actividad").
  PENDING
  IN_TRANSIT
  IN_ACTIVITY
  RESTING
  FINISHED
}

enum ItineraryStatus {
  PENDING
  IN_TRANSIT
  IN_PROGRESS
  COMPLETED
}

enum AnnouncementType {
  INFO
  ALERT
  ACHIEVEMENT
}

enum NotificationType {
  TRIP_ALERT
  TRIP_ACHIEVEMENT
  MONITOR_JOINED
  TRIP_STATUS_CHANGED
  SYSTEM_ERROR
  TRIP_NO_SIGNAL
  TRIP_NO_MONITOR
  // A push the central team sent from the panel to one trip's coordinators, or to every trip in the field.
  COORDINATOR_MESSAGE
}

model School {
  id    String @id @default(cuid())
  name  String @unique
  trips Trip[]
}

model AdminUser {
  id                  String    @id @default(cuid())
  clerkUserId         String    @unique
  createdAt           DateTime  @default(now())
  notificationsSeenAt DateTime?
}

model Trip {
  id                   String     @id @default(cuid())
  name                 String
  groupNumber          String?
  grade                String?
  salesExecutive       String?
  destination          String
  schoolId             String
  school               School     @relation(fields: [schoolId], references: [id])
  startDate            DateTime
  endDate              DateTime
  status               TripStatus @default(PENDING)
  currentDay           Int        @default(1)
  totalDays            Int
  studentCount         Int
  studentCountMale     Int?
  studentCountFemale   Int?
  companionCountMale   Int?
  companionCountFemale Int?
  initialLat           Float
  initialLng           Float
  hotel                String?
  programId            String
  program              Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt            DateTime   @default(now())

  memberships    TripMembership[]
  accessCodes    AccessCode[]
  itineraryItems ItineraryItem[]
  announcements  Announcement[]
  locationPings  LocationPing[]
  trackingTokens TrackingToken[]
  legs           TripLeg[]
  notifications  Notification[]

  @@index([schoolId])
  @@index([programId])
}

model TripLeg {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order     Int
  label     String
  lat       Float
  lng       Float
  startDate DateTime?
  endDate   DateTime?

  @@index([tripId])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  items ProgramItem[]
  trips Trip[]
}

model ProgramItem {
  id                  String  @id @default(cuid())
  programId           String
  program             Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber           Int
  time                String
  title               String
  location            String
  description         String
  requirementsMessage String?
  order               Int

  @@index([programId])
}

model AccessCode {
  id        String   @id @default(cuid())
  code      String   @unique
  role      Role
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tripId])
}

model TripMembership {
  id          String   @id @default(cuid())
  clerkUserId String
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime @default(now())

  @@unique([clerkUserId, tripId, role])
  @@index([tripId])
}

model ItineraryItem {
  id                  String          @id @default(cuid())
  tripId              String
  trip                Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber           Int             @default(1)
  time                String
  title               String
  location            String
  description         String
  status              ItineraryStatus @default(PENDING)
  order               Int
  photoUrl            String?
  requirementsMessage String?
  requirementsSentAt  DateTime?

  @@index([tripId])
}

model Announcement {
  id         String           @id @default(cuid())
  tripId     String
  trip       Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title      String
  message    String
  authorName String
  type       AnnouncementType @default(INFO)
  photoUrl   String?
  createdAt  DateTime         @default(now())

  @@index([tripId])
}

// Shared by every admin: a single feed, with per-admin unread state tracked
// as AdminUser.notificationsSeenAt rather than one read row per notification.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  tripId    String?
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([tripId])
}

model AnnouncementTemplate {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      AnnouncementType @default(INFO)
  category  String?
  createdAt DateTime         @default(now())
}

model ActivityTemplate {
  id                  String   @id @default(cuid())
  title               String
  destination         String?
  defaultLocation     String?
  description         String
  requirementsMessage String?
  createdAt           DateTime @default(now())
}

model RedeemAttempt {
  id          String   @id @default(cuid())
  clerkUserId String
  createdAt   DateTime @default(now())

  @@index([clerkUserId, createdAt])
}

model LocationPing {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracy  Int
  /// When the phone took the fix. Pings sent in a batch (background tracking, after a stretch
  /// without signal) carry the phone's capture time here, not the time they reached the server.
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}

/// Lets a coordinator's phone send the trip's location from the background, where no Clerk session
/// is at hand (Android keeps the tracking service running after the app is closed). Only the hash is
/// stored; the token only allows sending locations for this trip, and is revoked when the
/// coordinator pauses tracking, signs out or a new token is issued.
model TrackingToken {
  id          String    @id @default(cuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  clerkUserId String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([tripId, clerkUserId])
}

/// A phone that receives push notifications (an Expo push token), for the signed-in user who
/// registered it. The same phone signing in with another account moves the token to that account.
model PushDevice {
  id          String   @id @default(cuid())
  clerkUserId String
  token       String   @unique
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
}
