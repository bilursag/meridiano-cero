generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  MONITOR
  STUDENT
}

enum TripStatus {
  IN_TRANSIT
  IN_ACTIVITY
  RESTING
  FINISHED
}

enum ItineraryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AnnouncementType {
  INFO
  ALERT
  ACHIEVEMENT
}

model School {
  id    String @id @default(cuid())
  name  String @unique
  trips Trip[]
}

model AdminUser {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
}

model Trip {
  id                   String     @id @default(cuid())
  name                 String
  groupNumber          String?
  grade                String?
  salesExecutive       String?
  destination          String
  schoolId             String
  school               School     @relation(fields: [schoolId], references: [id])
  startDate            DateTime
  endDate              DateTime
  status               TripStatus @default(IN_TRANSIT)
  currentDay           Int        @default(1)
  totalDays            Int
  studentCount         Int
  studentCountMale     Int?
  studentCountFemale   Int?
  companionCountMale   Int?
  companionCountFemale Int?
  initialLat           Float
  initialLng           Float
  hotel                String?
  programId            String
  program              Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt            DateTime   @default(now())

  memberships    TripMembership[]
  accessCodes    AccessCode[]
  itineraryItems ItineraryItem[]
  announcements  Announcement[]
  locationPings  LocationPing[]
  legs           TripLeg[]

  @@index([schoolId])
  @@index([programId])
}

model TripLeg {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order     Int
  label     String
  lat       Float
  lng       Float
  startDate DateTime?
  endDate   DateTime?

  @@index([tripId])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  items ProgramItem[]
  trips Trip[]
}

model ProgramItem {
  id                  String  @id @default(cuid())
  programId           String
  program             Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber           Int
  time                String
  title               String
  location            String
  description         String
  requirementsMessage String?
  order               Int

  @@index([programId])
}

model AccessCode {
  id        String   @id @default(cuid())
  code      String   @unique
  role      Role
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tripId])
}

model TripMembership {
  id          String   @id @default(cuid())
  clerkUserId String
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime @default(now())

  @@unique([clerkUserId, tripId, role])
  @@index([tripId])
}

model ItineraryItem {
  id                  String          @id @default(cuid())
  tripId              String
  trip                Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber           Int             @default(1)
  time                String
  title               String
  location            String
  description         String
  status              ItineraryStatus @default(PENDING)
  order               Int
  photoUrl            String?
  requirementsMessage String?

  @@index([tripId])
}

model Announcement {
  id         String           @id @default(cuid())
  tripId     String
  trip       Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title      String
  message    String
  authorName String
  type       AnnouncementType @default(INFO)
  photoUrl   String?
  createdAt  DateTime         @default(now())

  @@index([tripId])
}

model AnnouncementTemplate {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      AnnouncementType @default(INFO)
  category  String?
  createdAt DateTime         @default(now())
}

model ActivityTemplate {
  id                  String   @id @default(cuid())
  title               String
  destination         String?
  defaultLocation     String?
  description         String
  requirementsMessage String?
  createdAt           DateTime @default(now())
}

model RedeemAttempt {
  id          String   @id @default(cuid())
  clerkUserId String
  createdAt   DateTime @default(now())

  @@index([clerkUserId, createdAt])
}

model LocationPing {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracy  Int
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}
